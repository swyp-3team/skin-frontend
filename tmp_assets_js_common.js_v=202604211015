(function() {
	const Common = {
		$doc: $(document),
		playList: [],
		menuList: [
			'.section00',
			'.section01',
			'.section02',
			'.section03',
			'.section04',
			'.section05',
			'.section06',
			'.section07',
		],
		pLoad: false,
		mPlay_list: null,
		gnbWrap: null,
		logo: null,
		mobileMenuBtn: null,
		mobileCloseBtn: null,
		isMobile: function() {
			const userAgent = navigator.userAgent.toLowerCase();
			const mobileDevices = ['iphone', 'ipod', 'blackberry', 'android', 'windows ce', 'lg', 'mot', 'samsung', 'sonyericsson'];
			return mobileDevices.some(device => userAgent.includes(device));
		},
		resize: function() {
			const width = $(document).width();
			Common.gnbWrap && Common.gnbWrap.toggle(width >= 768);
		},
		scrollEvent: function() {
			const elems = $('.on-scroll-down');
			$(elems).each((idx, elem) => {
				const $obj = $(elem);
				if (Common.isScrollDown($obj, -20)) {
					$obj.addClass("play-mo");
				} else {
					$obj.removeClass("play-mo");
				}
			});
			const upElems = $('.on-scroll-up');
			$(upElems).each((idx, elem) => {
				const $obj = $(elem);
				if (Common.isScrollUp($obj, 100)) {
					$obj.addClass("play-mo");
				} else {
					$obj.removeClass("play-mo");
				}
			});
			Common.setMenu();
		},
		setMenu: function() {
			const scrollTop = $(document).scrollTop() + $("header").height();
			$.each(Common.menuList, (idx) => {
				const $menuItem = $(Common.menuList[idx]);
				if ($menuItem.offset()) {
					const menuTop = $menuItem.offset().top;
					const menuBottom = menuTop + $menuItem.height();
					if (menuTop <= scrollTop && menuBottom >= scrollTop) {
						$("header ul li").removeClass("active");
						$("header ul li a").eq(idx).parent().addClass("active");
					}
				}
			});
			$("header").toggleClass("fixed", $(document).scrollTop() > $("header").height());
		},
		mmPlay_init: function(code, auto) {
			Common.mPlay_list = new YT.Player("move_player_ifr", {
				height: $(".movieFrame").height(),
				width: $(".movieFrame").width(),
				videoId: code,
				playerVars: {
					'playsinline': 1,
					'autoplay': auto,
					'mute': 0,
					'rel': 0,
					'wmode': 'opaque'
				},
				events: {
					'onReady': (event) => {
						if (auto === 1) {
							event.target.playVideo();
						}
					},
					'onStateChange': (event) => {
						// 필요한 경우 상태 변경 처리
					}
				}
			});
		},
		isScrollDown: function(elem, triggerDiff) {
			const top = elem.offset().top;
			const innerHeight = $(window).height() + $(document).scrollTop();
			return top < (innerHeight + triggerDiff);
		},
		isScrollUp: function(elem, triggerDiff) {
			const top = elem.offset().top + elem.height();
			const innerHeight = $(window).height() + $(document).scrollTop();
			return top > (innerHeight - $(window).height() / 2);
		},
		metaData: function(callback) {
			const data = {
				'S_TITLE': $('meta[property="og:title"]').attr('content'),
				'S_DESC': $('meta[property="og:description"]').attr('content'),
				'S_IMAGE': $('meta[property="og:image"]').attr('content')
			};
			if (data['S_TITLE'] === data['S_DESC']) {
				data['S_DESC'] = "";
			}
			if ($.isFunction(callback)) {
				callback.call($(this), data);
			}
		},
		copy_share: function(data) {
			// const text = `${data['S_TITLE']}\n${data['S_DESC']}\n${location.href}`;
			const text = location.href;
			Common.copyToClipboard(text);
		},
		copyToClipboard: function(val) {
			const textarea = document.createElement("textarea");
			document.body.appendChild(textarea);
			textarea.value = val;
			textarea.select();
			document.execCommand('copy');
			document.body.removeChild(textarea);
			alert("복사되었습니다.");
		},
		stopVideosInSpecificPopup: function(popupClass) {
			// 특정 팝업 내의 영상만 정지
			const modalPopup = $(`.b-modal .${popupClass}`);
			if (modalPopup.length > 0) {
				this.stopVideosInElement(modalPopup);
				return;
			}
			const originalPopup = $(`.${popupClass}`);
			if (originalPopup.length > 0) {
				this.stopVideosInElement(originalPopup);
				return;
			}
		},
		stopVideosInElement: function($element) {
			// 특정 요소 내의 영상만 정지
			const videos = $element.find('video');
			videos.each(function() {
				if (this.pause) this.pause();
			});
			const iframes = $element.find('iframe');
			iframes.each(function() {
				const iframe = this;
				const src = iframe.src;
				if (src.includes('vimeo.com')) {
					try {
						if (iframe.contentWindow && iframe.contentWindow.postMessage) {
							iframe.contentWindow.postMessage('{"method":"pause"}', '*');
						}
					} catch (e) {}
				}
				if (src.includes('youtube.com') || src.includes('youtu.be')) {
					try { iframe.src = ''; } catch (e) {}
				}
			});
		},

		CountDownTimer: function () {
			const $timers = $('[data-timer]');
			if ($timers.length === 0) return;
		
			const nodes = [];
			$timers.each(function () {
				const el = this;
				const raw = el.getAttribute('data-timer');
				const t = Number.isFinite(+raw) ? +raw : Date.parse(raw);
				if (Number.isNaN(t)) return;
		
				nodes.push({
					el,
					deadline: t,
					daysEl: el.querySelector('.days'),
					hoursEl: el.querySelector('.hours'),
					minutesEl: el.querySelector('.minutes'),
					secondsEl: el.querySelector('.seconds'),
					done: false
				});
			});
		
			if (nodes.length === 0) return;
		
			const pad2 = n => String(n).padStart(2, '0');
			const renderZero = n => {
				if (n.daysEl) n.daysEl.innerText = '00';
				if (n.hoursEl) n.hoursEl.innerText = '00';
				if (n.minutesEl) n.minutesEl.innerText = '00';
				if (n.secondsEl) n.secondsEl.innerText = '00';
				n.el.classList.add('timer-expired');
			};
		
			let timerId = null;
		
			const update = () => {
				const now = Date.now();
				let active = 0;
		
				for (const n of nodes) {
					if (n.done) continue;
		
					const distance = n.deadline - now;
					if (distance <= 0) {
						renderZero(n);
						n.done = true;
						continue;
					}
		
					active++;
		
					const days = Math.floor(distance / 86400000);
					const hours = Math.floor((distance % 86400000) / 3600000);
					const minutes = Math.floor((distance % 3600000) / 60000);
					const seconds = Math.floor((distance % 60000) / 1000);
		
					if (n.daysEl) n.daysEl.innerText = pad2(days);
					if (n.hoursEl) n.hoursEl.innerText = pad2(hours);
					if (n.minutesEl) n.minutesEl.innerText = pad2(minutes);
					if (n.secondsEl) n.secondsEl.innerText = pad2(seconds);
				}
		
				if (active === 0 && timerId) {
					clearInterval(timerId);
					timerId = null;
				}
			};
		
			update(); // 초기 실행
			timerId = setInterval(update, 1000);
		},

		init: function() {
			// 자주 쓰는 DOM 요소 캐싱
			Common.gnbWrap = $(".gnb-wrap");
			Common.logo = $(".logo");
			Common.mobileMenuBtn = $(".m_btn_menu");
			Common.mobileCloseBtn = $(".m_btn_close");

			//layer popup
			Common.$doc.on("click", ".pop_view", (e) => {
				e.preventDefault();
				const view = $(e.currentTarget).data("pop");
				$(`.${view}`).bPopup({
					onOpen: () => {
						$('html, body').addClass('scroll-disable');
						if (typeof $.fn.fullpage !== 'undefined') {
							$.fn.fullpage.setAllowScrolling(false);
							$.fn.fullpage.setKeyboardScrolling(false);
						}
					},
					onClose: () => {
						$('html, body').removeClass('scroll-disable');
						if (typeof $.fn.fullpage !== 'undefined') {
							$.fn.fullpage.setAllowScrolling(true);
							$.fn.fullpage.setKeyboardScrolling(true);
						}
						$('.b-modal .popup-content').off('wheel DOMMouseScroll');
						Common.stopVideosInSpecificPopup(view);
					},
					closeClass: 'btn_popClose',
					speed: 200,
					modalClose: true,
					transition: 'fadeIn',
					transitionClose: 'fadeOut',
					positionStyle: 'fixed',
					appendTo: 'body',
					position: ['auto', 'auto'],
					amsl:0,
					scrollBar: false
				});
			});

			// 아코디언 스타일 / FAQ 등
			Common.$doc.on('click', '.accordion .accordion__header', (e) => {
				const $header = $(e.currentTarget);
				const $item = $header.closest('.accordion__item');
				const $content = $item.find('.accordion__panel');
				const isActive = $item.hasClass('is-open');
				const $allItems = $item.closest('.accordion').find('.accordion__item');
			
				$allItems.not($item)
					.removeClass('is-open')
					.find('.accordion__panel')
					.stop()
					.slideUp(300);
			
				$allItems.not($item).find('.accordion__header').attr('aria-expanded', 'false');
			
				if (!isActive) {
					$header.attr('aria-expanded', 'true');
					$content.stop().slideDown(300, () => $item.addClass('is-open'));
				} else {
					$header.attr('aria-expanded', 'false');
					$content.stop().slideUp(300, () => $item.removeClass('is-open'));
				}
			});

			// 메뉴
			$('.gnb-wrap .gnb-menu-link').each(function() {
				$(this).on('click', (e) => {
					try {
						const idx = $('.gnb-wrap .gnb-menu-link').index(this);
						const targetSection = $(Common.menuList[idx]);
						const header = $('header');
						if (!targetSection.length || !header.length) return;
						const scrollPosition = targetSection.offset().top
							- header.outerHeight() // 메뉴 높이 차감
							- parseInt(header.css('paddingTop'))
							+ (parseInt($(this).data('margin')) || 0);
						$('html, body').animate({ scrollTop: scrollPosition }, 1000);
						if (Common.mobileMenuBtn.is(':visible')) {
							Common.gnbWrap.hide();
							Common.logo.removeClass('mo');
						}
					} catch (error) {
						console.error('메뉴 클릭 처리 중 오류 발생:', error);
					}
				});
			});

			// 메뉴 링크 클릭
			$('[data-menulink]').on('click', function(e) {
				e.preventDefault();
				const targetSelector = $(this).data('menulink');
				$(targetSelector).find('a').trigger('click');
			});

			// 스크롤 이동
			$('.scroll_move').on('click', function(e) {
				e.preventDefault();
				const targetId = this.hash;
				const targetElement = $(targetId);
				if (targetElement.length) {
					$('html, body').animate({ scrollTop: targetElement.offset().top }, 500);
				}
			});

			// 상단 이동
			$('.topLink').on('click', function(e) {
				e.preventDefault();
				$('html, body').animate({ scrollTop: 0 }, 500);
			});
			
			// 헤더 로고 클릭 시 상단 이동
			Common.$doc.on('click', 'header .logo', function(e) {
				e.preventDefault();
				$('html, body').animate({ scrollTop: 0 }, 1000);
			});

			// 모바일 메뉴 토글
			const toggleMobileMenu = (show) => {
				Common.gnbWrap.toggle(show);
				Common.logo.toggleClass('mo', show);
			};
			Common.mobileMenuBtn.on('click', function(e) {
				e.preventDefault();
				Common.gnbWrap.show();
				Common.logo.addClass('mo');
				$('header').addClass('mobile_open');
			});
			Common.mobileCloseBtn.on('click', function(e) {
				e.preventDefault();
				Common.gnbWrap.hide();
				Common.logo.removeClass('mo');
				$('header').removeClass('mobile_open');
			});

			// 공유하기
			$('.link_share').on('click', function(e) {
				e.preventDefault();
				Common.metaData(Common.copy_share);
			});

			// 공통 탭 구현
			const syncTabContentPaneClass = ($nav, $content, tabGroup, activeTabId) => {
				if (!$content.length || !activeTabId || tabGroup == null) return;
				const prefix = `${tabGroup}-content--`;
				$nav.find('.tab-item').each(function() {
					const id = $(this).data('tab');
					if (id) {
						$content.removeClass(`${prefix}${id}`);
					}
				});
				$content.addClass(`${prefix}${activeTabId}`);
			};

			$('.tab[data-tab-group] .tab-item').on('click', function() {
				const tabGroup = $(this).closest('[data-tab-group]').data('tab-group');
				const tabId = $(this).data('tab');
				const $tabNav = $(this).closest('[data-tab-group]');
				$tabNav.find('.tab-item').removeClass('active');
				$(this).addClass('active');
				const contentGroup = $(`.tab-content[data-tab-group="${tabGroup}"]`);
				if (contentGroup.length) {
					syncTabContentPaneClass($tabNav, contentGroup, tabGroup, tabId);
					contentGroup.find('.tab-pane').removeClass('active');
					const targetPane = $(`#${tabId}`);
					if (targetPane.length) {
						targetPane.addClass('active');
						const stabId = targetPane.find('.tab-item.active').data('tab');
						const stargetPane = $(`#${stabId}`);
						if (stargetPane.length) {
							stargetPane.addClass('active');
						}
					}
				}
			});

			// 초기 활성 탭과 tab-content 배경용 클래스 동기화
			$('.tab[data-tab-group]').each(function() {
				const $nav = $(this);
				const group = $nav.data('tab-group');
				const $active = $nav.find('.tab-item.active').first();
				const activeId = $active.data('tab');
				const $content = $(`.tab-content[data-tab-group="${group}"]`);
				syncTabContentPaneClass($nav, $content, group, activeId);
			});

			// window load 이벤트
			$(window).on('load', function() {
				$(".on-load").addClass("play-mo");

				// main__titleArea 애니메이션 트리거
				// setTimeout(() => {
				// 	$(".main__titleArea").addClass("play-mo");
				// }, 500);

				$(window).bind("scroll", (e) => {
					Common.scrollEvent();
				});
				$(window).resize(() => {
					Common.resize();
				});
				Common.scrollEvent();

				const go_url = location.hash;
				if (go_url !== "") {
					const selector = go_url.replace("#", ".");
					const offsetEl = $(selector);
					if (offsetEl.length) {
						let offset = offsetEl.offset().top;
						if (!Common.isMobile()) {
							offset -= $("header").height();
						}
						setTimeout(() => {
							$('html,body').animate({ scrollTop: offset }, 500, "easeOutQuint");
						}, 1000);
					}
				}

				// ✅ UPDATED: DOM/스타일 준비 후 카운트다운 시작
				Common.CountDownTimer();
			});
		}
	};
	window.Common = Common;
})();

$(function() {
	Common.init();
});